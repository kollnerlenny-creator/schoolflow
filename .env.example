# Optional Gmail SMTP credentials for /api/send-welcome
GMAIL_USER=
GMAIL_PASS=

# Firebase client configuration
FIREBASE_API_KEY=

# Optional Instagram Business Graph API credentials for /api/instagram-publish
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_PUBLIC_BASE_URL=

# Required on Vercel for temporary slide hosting during Instagram direct publish
BLOB_READ_WRITE_TOKEN=

# Required on Vercel so only you can publish to Instagram from /social.html
SOCIAL_ADMIN_SECRET=
